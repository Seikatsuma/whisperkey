# WhisperKey API Configuration
# Copy this file to .env and fill in your keys

# Первая ступень — Deepgram nova-2. Точнее на 8 пунктов и вдвое быстрее Groq
# (замер на калибровке Егора, см. комментарий у DEEPGRAM_PARAMS в whisperkey.py).
# Без этого ключа программа работает — просто сразу идёт на вторую ступень.
# Получить ключ: https://console.deepgram.com (стартовый кредит $200, без карты)
DEEPGRAM_API_KEY=your_deepgram_key_here

# Вторая ступень — Groq whisper-large-v3. Обязателен: без него работает
# только офлайн-модель третьей ступени, а её качество заметно ниже.
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# ─── Резерв без VPN (19.10.26) ────────────────────────────────────────────────
# Deepgram и Groq с домашнего IP недоступны без VPN. Порядок ступеней без них:
# мост на сервере (SSH-туннель, поднимается сам) → Yandex → локальная модель.

# Выбор стратегии движков: auto (по умолчанию), remote (мост первым — сеть без
# VPN, не жечь таймауты мёртвых ступеней), local (только офлайн-модель).
# ASR_ENGINE=auto

# Yandex SpeechKit — облако, доступное из РФ без VPN. Ключ: консоль
# cloud.yandex.ru → сервисный аккаунт → роль speechkit.stt.user → «API-ключ».
# Пусто — ступени нет. Синхронный API: записи длиннее ~29с пропускаются.
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=   # нужен только для IAM-аккаунтов, для Api-Key не обязателен

# Серверный мост обычно не трогают: туннель поднимает лаунчер и сторож.
# REMOTE_ASR_URL=http://127.0.0.1:8092/audio/transcriptions

# ─── Локальное хранилище записей (20.10.26) ───────────────────────────────────
# По умолчанию записи дублируются в ~/Library/Application Support/WhisperKey/Recordings.
# Можно переопределить папку через переменную окружения (абсолютный путь).
# WHISPERKEY_RECORDINGS_DIR=/Users/имя/Custom/WhisperKeyRecordings
